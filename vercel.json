{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix backend",
  "buildCommand": "npm run build --prefix backend",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "backend/{dist,migrations,certs}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    { "path": "/internal/cron/minute", "schedule": "* * * * *" },
    { "path": "/internal/cron/daily", "schedule": "0 20 * * *" }
  ]
}
