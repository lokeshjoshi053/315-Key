APP_ENV=dev                      # dev | staging | prod
PORT=3000
DATABASE_URL=postgres://plots315:plots315@localhost:5432/plots315
DB_POOL_SIZE=10
MIGRATE_ON_START=true

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# openssl rand -base64 32   (AES-256 key for bank account / PAN)
CRYPTO_KEY=
BOOTSTRAP_ADMIN_MOBILE=          # 10-digit mobile promoted to ADMIN on boot
REFERRAL_LINK_BASE=https://315plots.app/r/
CORS_ORIGINS=
SWAGGER_ENABLED=true             # set false in prod

OTP_PROVIDER=log                 # log (dev only, refused in prod) | msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
GOOGLE_CLIENT_IDS=               # comma-separated Android/iOS/web OAuth client IDs

RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_BASE_URL=https://sandbox.cashfree.com/payout
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

S3_BUCKET=plots315-docs
S3_ENDPOINT=                     # blank for AWS; http://localhost:9090 for the compose S3 mock; R2 endpoint for Cloudflare
S3_REGION=ap-south-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

FCM_CREDENTIALS_FILE=            # path to Firebase service-account JSON; blank = push disabled
JOBS_ENABLED=true
