{
  "name": "plots315-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "node dist/migrate.js",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:live": "test/live/run.sh",
    "openapi": "nest build && node dist/openapi.js",
    "test:live:serverless": "MODE=serverless test/live/run.sh"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/s3-request-presigner": "3.1148.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "12",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "jose": "5.10.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "12.1.3",
    "@testcontainers/postgresql": "12.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "5.6.3"
  }
}
